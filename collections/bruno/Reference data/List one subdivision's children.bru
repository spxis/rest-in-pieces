meta {
  name: List one subdivision's children
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/subdivisions/:id/children
  body: none
  auth: none
}

params:query {
  limit: 10
  ~offset: 0
  ~page: 
  ~pageSize: 
  ~cursor: 
  ~max: 
  ~sortBy: 
  ~sortDirection: 
  ~q: 
  ~metadata: 
  ~resultsName: 
  seed: 1
  ~locale: 
  ~messy: 
  ~format: 
  ~delay: 
  ~trickle: 
  ~status: 
  ~fail: 
  ~auth: 
  ~safe: 
  ~table: 
  ~expand: 
}

params:path {
  id: 1
}

docs {
  The children whose `parent` is this subdivision's id, in id order: the same records `/subdivisions?parent={id}` returns, found without a scan. Paging, sorting, filters, search, formats, `expand`, `messy`, `safe` and the simulation all work as they do on `/subdivisions`.

  Any other parameter that names a field filters the results: `gender=female`, `province=Ontario,Quebec`, or ranges with `age[gte]=30&age[lt]=40` (`eq`, `ne`, `gt`, `gte`, `lt`, `lte`).
}
