meta {
  name: List one geographic feature's countries
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/geo/features/:id/countries
  body: none
  auth: none
}

params:query {
  limit: 10
  ~offset: 0
  ~page: 
  ~pageSize: 
  ~cursor: 
  ~max: 
  ~sortBy: 
  ~sortDirection: 
  ~q: 
  ~metadata: 
  ~resultsName: 
  seed: 1
  ~locale: 
  ~messy: 
  ~format: 
  ~delay: 
  ~trickle: 
  ~status: 
  ~fail: 
  ~auth: 
  ~safe: 
  ~table: 
  ~expand: 
}

params:path {
  id: 1
}

docs {
  The countries this geographic feature lists in its `countries`, in the order it lists them. Paging, sorting, filters, search, formats, `expand`, `messy`, `safe` and the simulation all work as they do on `/countries`.

  Any other parameter that names a field filters the results: `gender=female`, `province=Ontario,Quebec`, or ranges with `age[gte]=30&age[lt]=40` (`eq`, `ne`, `gt`, `gte`, `lt`, `lte`).
}
