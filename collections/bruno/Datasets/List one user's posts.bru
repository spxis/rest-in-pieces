meta {
  name: List one user's posts
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/users/:id/posts
  body: none
  auth: none
}

params:query {
  limit: 10
  ~offset: 0
  ~page: 
  ~pageSize: 
  ~cursor: 
  ~max: 
  ~sortBy: 
  ~sortDirection: 
  ~q: 
  ~metadata: 
  ~resultsName: 
  seed: 1
  ~locale: 
  ~messy: 
  ~format: 
  ~delay: 
  ~trickle: 
  ~status: 
  ~fail: 
  ~auth: 
  ~safe: 
  ~table: 
  ~expand: 
}

params:path {
  id: 1
}

docs {
  The posts whose `userId` is this user's id, in id order: the same records `/posts?userId={id}` returns, found without a scan. Paging, sorting, filters, search, formats, `expand`, `messy`, `safe` and the simulation all work as they do on `/posts`.

  Any other parameter that names a field filters the results: `gender=female`, `province=Ontario,Quebec`, or ranges with `age[gte]=30&age[lt]=40` (`eq`, `ne`, `gt`, `gte`, `lt`, `lte`).
}
