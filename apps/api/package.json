{
  "name": "@johnmorrisdotca/rest-in-pieces",
  "version": "2.11.0",
  "description": "Realistic, repeatable fake data for building and testing client applications: a REST API you can run with npx, in-process or inside a browser tab.",
  "keywords": [
    "fake-data",
    "mock-api",
    "rest",
    "test-backend",
    "faker",
    "hono",
    "openapi",
    "seed"
  ],
  "homepage": "https://spxis.github.io/rest-in-pieces/",
  "bugs": "https://github.com/spxis/rest-in-pieces/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spxis/rest-in-pieces.git",
    "directory": "apps/api"
  },
  "license": "MIT",
  "author": "John Morris <john@spxis.com>",
  "type": "module",
  "bin": {
    "rest-in-pieces": "./bin/rest-in-pieces.js"
  },
  "exports": {
    ".": {
      "rest-in-pieces:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "rest-in-pieces:source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./browser": {
      "rest-in-pieces:source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./cursor": {
      "rest-in-pieces:source": "./src/cursor.ts",
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/main.d.ts",
    "!dist/server.*",
    "web"
  ],
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "node scripts/build.ts",
    "prepack": "pnpm --filter @rest-in-pieces/web build && node scripts/build.ts",
    "pack:test": "node scripts/pack-test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.6",
    "@johnmorrisdotca/address-plus": "^1.1.0",
    "country-data": "^0.0.31",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
