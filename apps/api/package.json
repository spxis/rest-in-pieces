{
  "name": "@johnmorrisdotca/rest-in-pieces",
  "version": "2.15.0",
  "description": "A mock REST API and test data generator with realistic, seeded fake data for building and testing frontends: related datasets with referential integrity, paging, sorting, filters, errors and delays on demand, safe values, SVG avatars, and NDJSON and SQL exports. Run it with npx, in Vite, through MSW or inside a browser tab.",
  "keywords": [
    "mock-api",
    "fake-api",
    "mock-server",
    "mock-rest-api",
    "fake-rest-api",
    "rest-api",
    "rest",
    "api-mocking",
    "mocking",
    "json-server",
    "jsonplaceholder",
    "dummy-api",
    "fake-data",
    "mock-data",
    "dummy-data",
    "test-data",
    "fixtures",
    "seed",
    "deterministic",
    "faker",
    "test-backend",
    "frontend",
    "prototyping",
    "testing",
    "e2e",
    "playwright",
    "cypress",
    "storybook",
    "msw",
    "mock-service-worker",
    "vite",
    "vite-plugin",
    "nextjs",
    "openapi",
    "swagger",
    "hono",
    "typescript",
    "pagination",
    "filtering",
    "latency",
    "error-simulation",
    "csv",
    "docker",
    "cli",
    "i18n",
    "japanese",
    "synthetic-data",
    "rule-based",
    "test-data-generator",
    "data-generator",
    "mock-data-generator",
    "seed-data",
    "database-seeding",
    "sample-data",
    "relational-test-data",
    "referential-integrity",
    "jsonplaceholder-alternative",
    "dummyjson-alternative",
    "mockaroo-alternative",
    "ndjson",
    "derived-fields",
    "zipf",
    "data-distributions",
    "time-series",
    "mock-invoices",
    "mock-transactions",
    "geojson",
    "sql-insert",
    "placeholder-images",
    "avatar"
  ],
  "homepage": "https://spxis.github.io/rest-in-pieces/",
  "bugs": "https://github.com/spxis/rest-in-pieces/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spxis/rest-in-pieces.git",
    "directory": "apps/api"
  },
  "license": "MIT",
  "author": "John Morris <john@spxis.com>",
  "type": "module",
  "bin": {
    "rest-in-pieces": "bin/rest-in-pieces.js"
  },
  "exports": {
    ".": {
      "rest-in-pieces:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "rest-in-pieces:source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./browser": {
      "rest-in-pieces:source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./cursor": {
      "rest-in-pieces:source": "./src/cursor.ts",
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./images": {
      "rest-in-pieces:source": "./src/images.ts",
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./serialize": {
      "rest-in-pieces:source": "./src/serialize.ts",
      "types": "./dist/serialize.d.ts",
      "default": "./dist/serialize.js"
    },
    "./msw": {
      "rest-in-pieces:source": "./src/msw.ts",
      "types": "./dist/msw.d.ts",
      "default": "./dist/msw.js"
    },
    "./vite": {
      "rest-in-pieces:source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./openapi.json": "./dist/openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/main.d.ts",
    "!dist/server.*",
    "web"
  ],
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "node scripts/build.ts",
    "prepack": "pnpm --filter @rest-in-pieces/web build && node scripts/build.ts",
    "pack:test": "node scripts/pack-test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@johnmorrisdotca/address-plus": "^1.1.0",
    "@scalar/hono-api-reference": "^0.12.6",
    "country-data": "^0.0.31",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "msw": ">=2",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
