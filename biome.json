{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!collections",
      "!scripts/family-template.mjs",
      "!scripts/family-readme.mjs",
      "!apps/web/public/family.css",
      "!apps/api/scripts/docs-site.mjs",
      "!apps/api/scripts/readme-lint.mjs",
      "!apps/api/scripts/family-template.mjs",
      "!apps/api/src/docs-site.test.js",
      "!apps/api/src/readme.test.js",
      "!apps/api/e2e/docs-site.demo.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
