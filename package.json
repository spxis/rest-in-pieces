{
  "name": "rest-in-pieces-workspace",
  "version": "2.3.0",
  "private": true,
  "description": "A REST service that serves realistic, repeatable fake data for building and testing client applications.",
  "license": "MIT",
  "author": "John Morris <john@spxis.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter rest-in-pieces dev",
    "dev:web": "pnpm --filter @rest-in-pieces/web dev",
    "start": "pnpm --filter rest-in-pieces start",
    "build": "pnpm --filter @rest-in-pieces/web build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter rest-in-pieces test:coverage",
    "test:e2e": "playwright test",
    "pack:test": "pnpm --filter rest-in-pieces pack:test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
