{
  "name": "rest-in-pieces-workspace",
  "version": "3.2.1",
  "private": true,
  "description": "A REST service that serves realistic, repeatable fake data for building and testing client applications.",
  "license": "MIT",
  "author": "John Morris <john@spxis.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter @rest-in-pieces/web build",
    "check": "pnpm --filter @johnmorrisdotca/rest-in-pieces build && node --test scripts/family.test.mjs && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:test",
    "collections": "node scripts/collections.ts",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @johnmorrisdotca/rest-in-pieces dev",
    "dev:web": "pnpm --filter @rest-in-pieces/web dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "pack:test": "pnpm --filter @johnmorrisdotca/rest-in-pieces pack:test",
    "readme:animation": "node scripts/readme-animation.ts",
    "release": "node scripts/release.ts",
    "start": "pnpm --filter @johnmorrisdotca/rest-in-pieces start",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @johnmorrisdotca/rest-in-pieces test:coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "family:readme": "node scripts/family-readme.mjs",
    "site": "pnpm --dir apps/api site",
    "docs:site": "pnpm --dir apps/api docs:site && node scripts/copy-docs.mjs",
    "docs:check": "pnpm --dir apps/api docs:check",
    "test:demo": "pnpm --dir apps/api test:demo && pnpm test:e2e",
    "test:readme": "pnpm --dir apps/api test:readme",
    "test:package": "pnpm pack:test",
    "screenshots:readme": "node scripts/screenshots-readme.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
